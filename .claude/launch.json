{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "apps/api/.venv/bin/uvicorn",
      "runtimeArgs": ["--app-dir", "apps/api", "main:app", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=apps/web"],
      "port": 5173
    }
  ]
}
